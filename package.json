{
  "name": "@orki/checkout-widget",
  "version": "1.0.0",
  "description": "Embeddable checkout widget",
  "main": "dist/checkout-widget.umd.js",
  "module": "dist/checkout-widget.es.js",
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build && tsc --declaration --emitDeclarationOnly --noEmit false --outDir dist && node -e \"require('fs').copyFileSync('index.html', 'dist/index.html'); require('fs').copyFileSync('demo.html', 'dist/demo.html')\"",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "typescript": "^5.2.2",
    "vite": "^5.0.0"
  },
  "types": "dist/main.d.ts"
}
